{
  "name": "frauthctf-local-auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "node --env-file=.env.local node_modules/vite/bin/vite.js --host 127.0.0.1 --port 3000",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "build": "vite build",
    "start": "node --env-file=.env.local scripts/start.mjs",
    "setup:local": "node scripts/setup-local.mjs",
    "seed:local": "node --env-file=.env.local --experimental-strip-types scripts/seed-local.ts",
    "migrate:local-mfa": "node --env-file=.env.local --experimental-strip-types scripts/migrate-local-mfa.ts",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.11",
    "better-sqlite3": "12.11.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@sveltejs/adapter-node": "6.0.0",
    "@sveltejs/kit": "3.1.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "svelte": "5.57.2",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "engines": {
    "node": "24.22.0"
  }
}
